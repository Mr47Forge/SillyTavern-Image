+    const images = [{ insert_after: 1, scene: 'The book rests on the table', characters: [] }];
+    const payload = JSON.stringify({ name: 'submit_scene_plan', arguments: { images } });
+    const malformed = '<tool_call>' + payload + '</｜DSML｜function_calls>';
+    const valid = '<tool_call>' + payload + '</tool_call>';
+    let calls = 0;
+    const sent = [];
